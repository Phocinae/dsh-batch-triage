{
  "name": "dsh-batch-triage",
  "description": "Deterministic-first triage for DeepSeek Harness: a rule prefilter classifies every ticket, and anything no rule can place is needs_review rather than guessed at. No model, no service, no network.",
  "version": "0.1.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Phocinae/dsh-batch-triage.git"
  },
  "homepage": "https://github.com/Phocinae/dsh-batch-triage#readme",
  "bugs": {
    "url": "https://github.com/Phocinae/dsh-batch-triage/issues"
  },
  "author": "PerryLink",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./lib/triage.mjs": "./lib/triage.mjs",
    "./lib/prefilter.mjs": "./lib/prefilter.mjs",
    "./lib/exit.mjs": "./lib/exit.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "tools.mjs",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "triage",
    "batch",
    "deterministic",
    "prefilter",
    "no-network",
    "phocinae"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "prepack": "npm test && npm run verify:artifacts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
